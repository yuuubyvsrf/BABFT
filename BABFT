            Rayfield:Notify({
                Title = "AutoFarm Aktif",
                Content = "Konumlar geziliyor (Son konumda 10 sn hazine beklemesi aktif).",
                Duration = 3,
                Image = 4483362458,
            })
            StartAutoFarmLoop()
        else
            Rayfield:Notify({
                Title = "AutoFarm Durduruldu",
                Content = "İşlem güvenli bir şekilde sonlandırıldı.",
                Duration = 3,
                Image = 4483362458,
            })
        end
    end,
})

