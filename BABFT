-- Durum Değişkeni
local autoFarmActive = false

-- Güvenli Karakter Kök Parçasını Alma Fonksiyonu
local function GetHumanoidRootPart()
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    return character:FindFirstChild("HumanoidRootPart")
end

-- Kararlı ve Güvenli AutoFarm Döngüsü
local function StartAutoFarmLoop()
    task.spawn(function()
        while autoFarmActive do
            local rootPart = GetHumanoidRootPart()
            if not rootPart then
                task.wait(1)
                continue
            end

            -- Her bir konuma sırasıyla gitme
            for index, targetPosition in ipairs(waypoints) do
                if not autoFarmActive then break end
                
                -- Karakterin anlık konumunu güvenli bir şekilde hedef konuma sabitleme
                local currentRoot = GetHumanoidRootPart()
                if currentRoot then
                    currentRoot.CFrame = CFrame.new(targetPosition)
                    
                    -- Hız dalgalanmalarını önlemek ve kararlılığı korumak için hareket kuvvetini sıfırlama
                    if currentRoot:FindFirstChild("BodyVelocity") == nil then
                        currentRoot.Velocity = Vector3.new(0, 0, 0)
                    end
                end

                -- Bekleme Süreleri: 10. konumda 10 saniye (hazine alımı için), diğer konumlarda 1 saniye
                if index == #waypoints then
                    task.wait(10)
                else
                    task.wait(1)
                end
            end

            -- Döngü tamamlandığında tekrar başlatmadan önce kısa bir dinlenme süresi
            task.wait(2)
        end
    end)
end

-- Rayfield Toggle (Açma/Kapatma) Elemanı
